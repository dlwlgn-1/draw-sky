# Copy to .env.local and fill in from Firebase console → Project settings → Your apps → Web app (SDK setup and configuration).
# With these set, `npm run dev` and `npm run build:web` use Firebase instead of the claude.ai artifact runtime.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Only if the site lives somewhere other than https://<project id>.web.app/ (e.g. your own domain): its address, for link previews.
# VITE_SITE_URL=https://example.com/
# Uncomment to use the local emulators (`npx firebase-tools emulators:start`) instead of the real project.
# VITE_FIREBASE_EMULATOR=1
