rules_version = '2';
// Everyone may read; each signed-in player writes only their own documents.
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['entries', 'votes', 'stats', 'hall', 'nick']);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /presence/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['cid', 'drawing', 'at']);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
